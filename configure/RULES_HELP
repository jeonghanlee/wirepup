.PHONY: help help.detail

##@ Help
## Show the primary build, install, and verification workflows
help:
	$(QUIET) printf '%s\n' 'Usage: make <target> [VAR=value]' \
	    'Run these commands from the WirePup repository directory.' '' 'Workflows'
	$(QUIET) printf '  %-18s   %s\n' 'Stage' 'Command' \
	    '------------------' '--------------------------------' \
	    'Verify' 'make check' \
	    'Build' 'make build' \
	    'Preview install' 'make install.dry-run' \
	    'Install' 'make install' \
	    'Verify install' 'make install.check' \
	    'Uninstall' 'make uninstall' \
	    'Preview system' 'make install.dry-run INSTALL_LOCATION=/usr/local' \
	    'Install system' 'make install INSTALL_LOCATION=/usr/local' \
	    'Verify system' 'make install.check INSTALL_LOCATION=/usr/local' \
	    'Uninstall system' 'make uninstall INSTALL_LOCATION=/usr/local'
	$(QUIET) printf '\n%s\n' 'Installation uses sudo only when the destination requires it; do not run sudo make.'
	$(QUIET) printf '%s\n' 'Existing files require confirmation. For explicitly approved automation: INSTALL_FORCE=1.'
	$(QUIET) printf '\n%s\n' 'Details: make help.detail'
	$(QUIET) :

## List targets grouped by role
help.detail:
	$(QUIET) printf '  %-22s   %s\n' 'Target' 'Description' \
	    '----------------------' '----------------------------------------'
	$(QUIET) awk '$(HELP_AWK)' $(foreach file,$(MAKEFILE_LIST),$(call shell_quote,$(file)))
	$(QUIET) :
