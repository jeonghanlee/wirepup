.PHONY: install install.dry-run install.apply install.check install.preflight uninstall

# Check before any build in a combined build/install invocation.
ifneq ($(filter install install.apply,$(MAKECMDGOALS)),)
build: install.preflight
endif

install.preflight:
	$(QUIET) $(INSTALL_ENV) bash $(call shell_quote,$(INSTALL_TOOL)) preflight $(INSTALL_ARGS)

##@ Installation
## Build and install at INSTALL_LOCATION (alias of install.apply)
install: install.apply

## Preview the installation path and required privileges
install.dry-run:
	$(QUIET) $(INSTALL_ENV) bash $(call shell_quote,$(INSTALL_TOOL)) dry-run $(INSTALL_ARGS)

## Install the executable and Bash completion under INSTALL_LOCATION
install.apply: install.preflight build
	$(QUIET) $(INSTALL_ENV) bash $(call shell_quote,$(INSTALL_TOOL)) apply $(INSTALL_ARGS)

## Verify executable, version, PATH, and installed Bash completion
install.check:
	$(QUIET) $(INSTALL_ENV) bash $(call shell_quote,$(INSTALL_TOOL)) check $(INSTALL_ARGS)

## Remove the executable, completion, and any RHEL symlink under INSTALL_LOCATION
uninstall:
	$(QUIET) $(INSTALL_ENV) bash $(call shell_quote,$(INSTALL_TOOL)) uninstall $(INSTALL_ARGS)
