.PHONY: check-go check-gofmt check-cc check-tools test race vet fmt-check mode-check check

check-go:
	$(QUIET) if ! command -v "$(GO)" >/dev/null 2>&1; then \
	    printf '%s\n' 'error: Go not found; set GO to a Go executable.' \
	        'Install Go from https://go.dev/dl/ at the version required by go.mod or newer.'; \
	    exit 1; \
	fi

check-gofmt: check-go
	$(QUIET) if ! command -v "$(GOFMT)" >/dev/null 2>&1; then \
	    printf '%s\n' 'error: gofmt not found; install the complete Go toolchain or set GOFMT.'; \
	    exit 1; \
	fi

check-cc: check-go
	$(QUIET) compiler="$$("$(GO)" env CC)"; \
	if ! command -v "$${compiler%% *}" >/dev/null 2>&1; then \
	    printf '%s\n' 'error: the race detector requires a C compiler.' \
	        'Install on Debian: apt install build-essential' \
	        'Install on Rocky Linux: dnf install gcc'; \
	    exit 1; \
	fi

##@ Verification
## Check Go and gofmt availability (race also checks the C compiler)
check-tools: check-gofmt

## Run unit and golden tests; TEST_FLAGS adds go test options
test: check-go
	$(QUIET) $(GO_ENV) "$(GO)" test $(TEST_FLAGS) $(PKG)

## Run tests under the race detector with cgo enabled
race: check-cc
	$(QUIET) $(RACE_ENV) "$(GO)" test -race $(TEST_FLAGS) $(PKG)

## Run go vet
vet: check-go
	$(QUIET) $(GO_ENV) "$(GO)" vet $(PKG)

## Fail if formatting is invalid or any Go file needs gofmt
fmt-check: check-gofmt
	$(QUIET) out="$$("$(GOFMT)" -l .)" || exit $$?; \
	if [ -n "$$out" ]; then \
	    printf 'gofmt needed:\n%s\n' "$$out"; \
	    exit 1; \
	fi

## Fail if a tracked file whose first line starts with #! is not mode 100755 in Git
mode-check:
	$(QUIET) prefix="$$(git rev-parse --show-prefix 2>/dev/null)" && [ -z "$$prefix" ] || { \
	    printf '%s\n' 'error: mode-check requires a Git checkout of this repository.' \
	        'Obtain the source with git clone so that file modes are recorded.'; \
	    exit 1; \
	}; \
	matches="$$(git -c core.quotePath=false grep --cached -I -n -e '^#!')"; \
	status=$$?; \
	if [ "$$status" -gt 1 ]; then exit "$$status"; fi; \
	out="$$(printf '%s\n' "$$matches" | sed -n 's/:1:#!.*$$//p' | while IFS= read -r path; do \
	    case "$$(git ls-files -s -- "$$path")" in 100755\ *) ;; *) printf '%s\n' "$$path" ;; esac; \
	done)"; \
	if [ -n "$$out" ]; then \
	    printf '%s\n' 'error: tracked files starting with #! are not mode 100755 in the Git index:' "$$out" \
	        'Set the mode with chmod +x and git add, or with git update-index --chmod=+x.'; \
	    exit 1; \
	fi

## Run formatting and mode checks, vet, and tests
check: fmt-check mode-check vet test
